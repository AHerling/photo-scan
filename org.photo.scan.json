<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <id>org.photo.scan</id>
  <runtime>org.kde.Platform</runtime>
  <runtime-version>6.9</runtime-version>
  <sdk>org.kde.Sdk</sdk>
  <command>photo-scan</command>
  <finish-args>
    <arg>--share=ipc</arg>
    <arg>--socket=x11</arg>
    <arg>--socket=wayland</arg>
    <arg>--device=dri</arg>
    <arg>--share=network</arg>
    <arg>--device=all</arg>
    <arg>--filesystem=home</arg>
    <arg>--filesystem=/tmp</arg>
    <arg>--talk-name=org.freedesktop.Avahi</arg>
    <arg>--system-talk-name=org.freedesktop.Avahi</arg>
  </finish-args>
  <modules>
    <module>
      <name>sane-backends</name>
      <buildsystem>autotools</buildsystem>
      <sources>
        <source type="git">
          <url>https://gitlab.com/sane-project/backends.git</url>
          <tag>1.4.0</tag>
        </source>
      </sources>
    </module>
    <module>
      <name>sane-airscan</name>
      <buildsystem>meson</buildsystem>
      <sources>
        <source type="git">
          <url>https://github.com/alexpevzner/sane-airscan.git</url>
          <tag>0.99.36</tag>
        </source>
      </sources>
      <build-options>
        <opt>--buildtype=release</opt>
      </build-options>
    </module>
    <module>
      <name>python-deps</name>
      <buildsystem>simple</buildsystem>
      <build-commands>
        <command>pip3 install --prefix=/app opencv-python-headless numpy</command>
      </build-commands>
    </module>
    <module>
      <name>photo-scan</name>
      <buildsystem>simple</buildsystem>
      <build-commands>
        <command>pip3 install --prefix=/app .</command>
        <command>install -Dm644 org.photo.scan.desktop /app/share/applications/org.photo.scan.desktop</command>
        <command>install -Dm644 org.photo.scan.metainfo.xml /app/share/metainfo/org.photo.scan.metainfo.xml</command>
        <command>install -Dm644 LICENSE /app/share/licenses/org.photo.scan/LICENSE</command>
        <command>install -Dm644 photo-scan.png /app/share/icons/hicolor/256x256/apps/org.photo.scan.png || true</command>
      </build-commands>
      <sources>
        <source type="dir">
          <path>.</path>
        </source>
      </sources>
    </module>
  </modules>
</manifest>
